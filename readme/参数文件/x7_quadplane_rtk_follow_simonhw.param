# CUAV-X7 QuadPlane Simulation-on-Hardware defaults
# Flight-control baseline: param_my_quad_plane.param
# Used with Tools/scripts/sitl-on-hardware/sitl-on-hw.py --defaults.

# Simulation start position
SIM_OPOS_LAT 31.84517
SIM_OPOS_LNG 117.25010
SIM_OPOS_ALT 45
SIM_OPOS_HDG 90

# MAVLink and SoH interfaces
SYSID_THISMAV 1
AHRS_EKF_TYPE 10
GPS1_TYPE 100
GPS2_TYPE 0
SERIAL0_BAUD 115
SERIAL0_PROTOCOL 2
SERIAL3_BAUD 115
SERIAL3_PROTOCOL 5

# Reference QuadPlane baseline
THR_FAILSAFE 0
ARSPD_TYPE 0
ARSPD_USE 0
ARSPD_SKIP_CAL 0
ARMING_RUDDER 2
AIRSPEED_MAX 30
AIRSPEED_MIN 18
AUTOTUNE_LEVEL 8
FBWB_CLIMB_RATE 10
KFF_RDDRMIX 0.5
PTCH_LIM_MAX_DEG 30
PTCH_LIM_MIN_DEG -30
ROLL_LIMIT_DEG 24
NAVL1_PERIOD 14
PTCH_RATE_D 0
PTCH_RATE_I 0.2125
PTCH_RATE_IMAX 0.888889
PTCH_RATE_P 0.309954
PTCH_RATE_FF 1.407055
PTCH2SRV_RLL 1
RLL_RATE_D 0
RLL_RATE_I 0.2125
RLL_RATE_IMAX 0.888889
RLL_RATE_P 0.141009
RLL_RATE_FF 0.552741
THR_MAX 100
AIRSPEED_CRUISE 22
TECS_SYNAIRSPEED 1

# QuadPlane. Motor1-4 are assigned automatically to SERVO5-8 after reset.
Q_ENABLE 1
Q_FRAME_CLASS 1
Q_FRAME_TYPE 1
Q_MAV_TYPE 22
Q_OPTIONS 0
Q_ASSIST_SPEED 15
Q_M_THST_EXPO 0.65
Q_M_PWM_MIN 1000
Q_M_PWM_MAX 2000
Q_M_BAT_VOLT_MAX 12.8
Q_M_BAT_VOLT_MIN 9.6
Q_A_RAT_RLL_P 0.108
Q_A_RAT_RLL_I 0.108
Q_A_RAT_RLL_D 0.001
Q_A_RAT_PIT_P 0.103
Q_A_RAT_PIT_I 0.103
Q_A_RAT_PIT_D 0.001
Q_A_RAT_YAW_P 0.2
Q_A_RAT_YAW_I 0.02
Q_A_ANG_RLL_P 6
Q_A_ANG_PIT_P 6

# RC and output ranges from the reference configuration
RC1_DZ 30
RC1_MAX 1886
RC1_MIN 1087
RC1_TRIM 1500
RC3_MAX 2000
RC3_MIN 1000
SERVO3_MIN 1000
SERVO3_MAX 2000

# Return and flight modes
RTL_ALTITUDE 50
RTL_RADIUS 180
Q_RTL_ALT 50
Q_RTL_ALT_MIN 50
Q_RTL_MODE 1
FLTMODE_CH 8
FLTMODE1 19
FLTMODE2 5
FLTMODE3 7
FLTMODE4 90
FLTMODE5 19
FLTMODE6 20

# RTK follow mode
FOLL_ENABLE 1
FT_ALT 50
FT_SYSID 255
FT_RADIUS 250
FT_RAD_MIN 250
FT_RAD_MAX 250
FT_MAX_DIST 360
FT_CATCH_DIST 270
FT_PRE_DIST 300
FT_PRE_RATE 0.5
FT_RATE_TAU 4
FT_STOP_SPD 1
FT_STOP_SEC 3
FT_RESUME_SPD 3
FT_RESUME_SEC 4
FT_CMD_RATE 30
FT_STOP_RAD 500
FT_PREDICT 6
FT_CATCH_PRED 10
FT_SPEED_MIN 18
FT_SPEED_CRUISE 22
FT_SPEED_MAX 30
FT_TGT_MINSPD 3
FT_TGT_MAXSPD 20
FT_DIR 0
FT_ADAPTIVE 1
FT_LOSS_ORBIT 3
FT_LOSS_RTL 30

